# Copia este archivo a .env y ajusta los valores segun el entorno.
# El backend funciona con estos valores por defecto, pero jamas uses
# secret_key=demo en produccion.

APP_NAME=Sistema de Gestion de Telefonia
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/telefonia
SECRET_KEY=generar-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

MONEDA=CUP
LOCALE=es-CU

# Origenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Integracion opcional con ASSETS RH (RRHH). Deshabitada por defecto.
ASSETS_RRHH_HABILITADO=false
ASSETS_RRHH_SERVER=10.8.6.191
ASSETS_RRHH_DATABASE=ASSETS_RH
ASSETS_RRHH_USERNAME=
ASSETS_RRHH_PASSWORD=
ASSETS_RRHH_DRIVER=ODBC Driver 17 for SQL Server