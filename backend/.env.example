# Copia este archivo a .env y ajusta los valores segun el entorno.
# El backend funciona con estos valores por defecto, pero jamas uses
# secret_key con el valor por defecto en produccion.

APP_NAME=Sistema de Gestion de Telefonia
API_PREFIX=/api/v1
# development | production (produccion exige SECRET_KEY segura y DATABASE_URL no SQLite)
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dev.db
# En produccion genera una clave aleatoria de 32+ caracteres, p.ej.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generar-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

MONEDA=CUP
LOCALE=es-CU

# Password inicial del usuario admin que crea el seed (obligatorio, cumple la politica de passwords).
# Nunca uses una por defecto; el seed no crea el admin si falta o es debil.
ADMIN_INITIAL_PASSWORD=

# Origenes permitidos para CORS (separados por coma o JSON)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting del login (por IP y por usuario). Ajustable, desactivable en tests.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=1
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_RATE_LIMIT_HABILITADO=true

# Integracion opcional con ASSETS RH (RRHH). Deshabilitada por defecto.
ASSETS_RRH_HABILITADO=false
# Marcador: cambialo por el hostname real de tu entorno (jamas IPs/proxy publicos).
ASSETS_RRH_SERVER=servidor-rrhh.ejemplo.local
ASSETS_RRH_DATABASE=ASSETS_RH
ASSETS_RRH_USERNAME=
ASSETS_RRH_PASSWORD=
ASSETS_RRH_DRIVER=ODBC Driver 17 for SQL Server
# Encrypt=yes y TrustServerCertificate=no por defecto. Un servidor con certificado
# autofirmado exige activar TRUST_SERVER_CERTIFICATE=true de forma consciente.
ASSETS_RRH_ENCRYPT=true
ASSETS_RRH_TRUST_SERVER_CERTIFICATE=false
ASSETS_RRH_TIMEOUT=15